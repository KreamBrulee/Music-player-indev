# Rendered by ansible/monitoring.yml. Scrape targets come from the
# app_scrape_targets variable (the app instances' private IPs).
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: monitoring-host
    static_configs:
      - targets: ['host.docker.internal:9100']

  - job_name: app-node
    static_configs:
      - targets:
{% for ip in app_scrape_targets %}
          - '{{ ip }}:9100'
{% endfor %}

  - job_name: app-containers
    static_configs:
      - targets:
{% for ip in app_scrape_targets %}
          - '{{ ip }}:8080'
{% endfor %}
